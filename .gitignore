# Dependencies and build output
node_modules/
# The trailing slash above matches only a directory, so a node_modules symlink --
# what `git worktree` setups usually create -- would slip past it into a commit.
node_modules
/dist/

# Worktrees live inside the repo, so the checkout would otherwise track itself.
.claude/worktrees/
# Which session holds the scheduler; a pid and a session id, true for one machine.
.claude/scheduled_tasks.lock

# Test and coverage output
*.out
coverage.*

# Local environment
.env
.env.*
!.env.example
/data/

# IDE and OS files
.idea/
.vscode/
.DS_Store

# Agent run state: notes, plans, handoffs, session logs, project memory. One
# machine's working memory. Until now only a personal global ignore kept this
# out of a commit -- which held for one checkout and for nobody else's.
# `.omc/skills/` is the documented exception: project-scoped skills are meant
# to be committed, so the entry lists the directory's contents and spares it.
/.omc/*
!/.omc/skills/
