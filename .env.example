# Server binding and durable local state
HOST=127.0.0.1
PORT=3000
PARALLAX_STATE_FILE=data/parallax-state.json
PARALLAX_PROVIDER_STATE_FILE=data/provider-state.json
# Local fallback defaults on only for loopback development. Production should
# configure Cloudflare/CoreDNS and leave this false.
# PARALLAX_ALLOW_LOCAL_PROVIDER=false

# Optional production source of truth. Apply migrations/001_initial.sql first.
# DATABASE_URL=postgres://parallax:password@127.0.0.1:5432/parallax

# Optional CoreDNS RFC 1035 zone-file directory. Configure CoreDNS `auto` or a
# nonzero `file` reload interval to observe atomically replaced files and SOA
# serial changes.
# PARALLAX_COREDNS_DIRECTORY=/srv/coredns/zones

# Required with Cloudflare or CoreDNS; signs managed-record ownership markers.
# PARALLAX_OWNERSHIP_SECRET=replace-with-at-least-32-random-bytes

# Optional per-zone Cloudflare credentials. Use minimum-scope API tokens.
# PARALLAX_CLOUDFLARE_ZONES={"example.com":{"zoneId":"cloudflare-zone-id","token":"cloudflare-api-token"}}

# Optional encrypted admin-portal credential management. Configure both values.
# Generate a key with: openssl rand -base64 32
# PARALLAX_CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64-or-64-character-hex-key
# PARALLAX_CREDENTIAL_FILE=data/provider-credentials.enc

# Optional RBAC tokens. When omitted, authentication is disabled for local use.
# PARALLAX_AUTH_TOKENS=[{"token":"replace-with-a-long-random-value","role":"admin","subject":"owner"}]
