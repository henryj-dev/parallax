# Parallax reads only infrastructure and keys from the environment. Everything
# an administrator tunes -- provider wiring, retention, proxy origin, access
# tokens and provider credentials -- is stored in the database (or the local
# configuration file) and managed from the portal's Provider settings screen.

# Where the server binds.
HOST=127.0.0.1
PORT=3000

# Production source of truth. Apply migrations/*.sql in order first.
# `pg` leaves the session in cleartext unless the URL asks for TLS; prefer
# sslmode=verify-full, whose meaning does not change in a future pg release.
# DATABASE_URL=postgres://parallax:password@127.0.0.1:5432/parallax?sslmode=verify-full

# Used only when DATABASE_URL is absent: where the single-node files live.
PARALLAX_STATE_FILE=data/parallax-state.json
PARALLAX_CONFIG_FILE=data/parallax-config.json
PARALLAX_PROVIDER_STATE_FILE=data/provider-state.json

# Signs managed-record ownership markers. Required before Cloudflare or CoreDNS
# can be used. Rotating it makes Parallax disown every record it created.
# PARALLAX_OWNERSHIP_SECRET=replace-with-at-least-32-random-bytes

# Encrypts stored provider credentials. Required before credentials can be
# saved. Generate with: openssl rand -base64 32
# PARALLAX_CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64-or-64-character-hex-key

# Optional break-glass tokens for a deployment that has locked itself out.
# Normal tokens are issued from the portal and stored as digests.
# Each entry needs at least 32 bytes: openssl rand -base64 32
# PARALLAX_AUTH_TOKENS=[{"token":"replace-with-at-least-32-random-bytes","role":"admin","subject":"owner"}]
