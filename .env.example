# Parallax reads only infrastructure and keys from the environment. Everything
# an administrator tunes -- provider wiring, retention, proxy origin, access
# tokens and provider credentials -- is stored in the database (or the local
# configuration file) and managed from the portal's Provider settings screen.

# Where the server binds.
HOST=127.0.0.1
PORT=3000

# Production source of truth. Apply migrations/*.sql in order first.
# Non-loopback PostgreSQL URLs are refused unless they verify TLS. The explicit
# opt-out is for a separately protected network, and logs a warning.
# DATABASE_URL=postgres://parallax:password@db:5432/parallax?sslmode=verify-full
# PARALLAX_ALLOW_PLAINTEXT_POSTGRES=false

# Used only when DATABASE_URL is absent: where the single-node files live.
PARALLAX_STATE_FILE=data/parallax-state.json
PARALLAX_CONFIG_FILE=data/parallax-config.json
PARALLAX_PROVIDER_STATE_FILE=data/provider-state.json

# Immutable deployment-owned root beneath which the administrator may select a
# CoreDNS output directory. The stored `coreDnsDirectory` setting cannot leave
# this root through `..` or a symlink.

# Signs managed-record ownership markers. Required before Cloudflare or CoreDNS
# can be used. Rotating it makes Parallax disown every record it created.
# PARALLAX_OWNERSHIP_SECRET=replace-with-at-least-32-random-bytes

# Answer DNS for the internal view from this process, instead of publishing it
# into CoreDNS or PowerDNS. Unset leaves the port unbound. The listener binds
# PARALLAX_DNS_HOST, or HOST when that is unset, so it does not start answering
# the whole network because a port was set.
# PARALLAX_DNS_PORT=53
# PARALLAX_DNS_HOST=0.0.0.0

# Where names outside every managed zone go. Everything this process is not
# authoritative for is relayed here, so this belongs with the keys rather than
# in the settings a portal session can change. Empty answers REFUSED instead.
# PARALLAX_DNS_FORWARD_TO=1.1.1.1,9.9.9.9#53
# Only these client CIDRs may use the upstreams. Loopback is the default. A
# non-loopback DNS listener with forwarding refuses to start unless this is set.
# PARALLAX_DNS_FORWARD_ALLOW=10.0.0.0/8,2001:db8:1234::/48

# Full-zone transfers are denied by default and are available only over TCP.
# Name each secondary's network explicitly to enable AXFR.
# PARALLAX_DNS_TRANSFER_ALLOW=10.0.0.2/32,2001:db8:1234::2/128

# What the listener will spend on one client and on the network as a whole.
# Each is optional; unset leaves the listener's own default, shown here.
# An authoritative answer is larger than the question that asked for it, so a
# listener reachable from an untrusted network is worth lowering these on.
# PARALLAX_DNS_RATE_LIMIT_PER_SECOND=100
# PARALLAX_DNS_RATE_LIMIT_BURST=200
# How many client addresses the limiter tracks. Once full, an address it has
# not seen is refused -- so raise this where more distinct clients are expected.
# PARALLAX_DNS_RATE_LIMIT_MAX_CLIENTS=10000
# PARALLAX_DNS_FORWARD_TIMEOUT_MS=4000
# PARALLAX_DNS_MAX_CONCURRENT_FORWARDS=256
# PARALLAX_DNS_MAX_TCP_CONNECTIONS=1024

# Encrypts stored provider credentials. Required before credentials can be
# saved. Generate with: openssl rand -base64 32
# PARALLAX_CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64-or-64-character-hex-key

# Optional break-glass tokens for a deployment that has locked itself out.
# Normal tokens are issued from the portal and stored as digests.
# Tokens must be canonical base64url encoding of 32 random bytes:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# PARALLAX_AUTH_TOKENS=[{"token":"replace-with-the-43-character-output","role":"admin","subject":"owner"}]
