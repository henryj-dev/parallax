# Server binding and durable local state
HOST=127.0.0.1
PORT=3000
PARALLAX_STATE_FILE=data/parallax-state.json
PARALLAX_PROVIDER_STATE_FILE=data/provider-state.json
# Local fallback defaults on only for loopback development with no provider
# configured. Configuring Cloudflare or CoreDNS turns it off so an unroutable
# target fails loudly instead of being written to a local file.
# PARALLAX_ALLOW_LOCAL_PROVIDER=false

# Required behind a TLS-terminating reverse proxy so cookie-authenticated
# mutations can prove same-origin. Set one of these, not both.
# PARALLAX_PUBLIC_ORIGIN=https://dns.example.com
# PARALLAX_TRUST_FORWARDED_HEADERS=false

# Optional production source of truth. Apply migrations/001_initial.sql first.
# `pg` leaves the session in cleartext unless the URL asks for TLS; prefer
# sslmode=verify-full, whose meaning does not change in a future pg release.
# DATABASE_URL=postgres://parallax:password@127.0.0.1:5432/parallax?sslmode=verify-full

# Bounds stored history. 0 keeps everything, which grows without limit.
# PARALLAX_REVISION_RETENTION=100
# PARALLAX_AUDIT_RETENTION_DAYS=365

# Optional CoreDNS RFC 1035 zone-file directory. Configure CoreDNS `auto` or a
# nonzero `file` reload interval to observe atomically replaced files and SOA
# serial changes.
# PARALLAX_COREDNS_DIRECTORY=/srv/coredns/zones

# Required with Cloudflare or CoreDNS; signs managed-record ownership markers.
# PARALLAX_OWNERSHIP_SECRET=replace-with-at-least-32-random-bytes

# Optional per-zone Cloudflare credentials. Use minimum-scope API tokens.
# PARALLAX_CLOUDFLARE_ZONES={"example.com":{"zoneId":"cloudflare-zone-id","token":"cloudflare-api-token"}}

# Optional encrypted admin-portal credential management. Configure both values.
# Generate a key with: openssl rand -base64 32
# PARALLAX_CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64-or-64-character-hex-key
# PARALLAX_CREDENTIAL_FILE=data/provider-credentials.enc

# Optional RBAC tokens. When omitted, authentication is disabled for loopback
# development only and API requests arriving through a proxy are refused.
# Each token needs at least 32 bytes: openssl rand -base64 32
# PARALLAX_AUTH_TOKENS=[{"token":"replace-with-at-least-32-random-bytes","role":"admin","subject":"owner"}]
