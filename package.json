{
  "name": "@tinyuniverse/parallax",
  "version": "0.0.0",
  "private": true,
  "description": "A split-horizon DNS control plane",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "audit": "pnpm audit --audit-level moderate",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "cli": "node --env-file-if-exists=.env cmd/parallax/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "test": "node --test --test-timeout=120000 --import ./scripts/watchdog.ts",
    "test:ci": "node --test --test-timeout=120000 --import ./scripts/watchdog.ts --test-reporter=tap",
    "test:coverage": "node --test --test-timeout=120000 --experimental-test-coverage",
    "test:watch": "node --test --watch",
    "verify:cloudflare": "bash scripts/verify-cloudflare.sh",
    "verify:dns": "bash scripts/verify-dns.sh",
    "verify:integration": "pnpm verify:postgres && pnpm verify:proxy && pnpm verify:dns && pnpm verify:cloudflare",
    "verify:postgres": "bash scripts/verify-postgres.sh",
    "verify:proxy": "bash scripts/verify-proxy.sh",
    "check:portal": "tsc -p tsconfig.portal.json"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "bin": {
    "parallax": "dist/cmd/parallax/main.js"
  }
}
