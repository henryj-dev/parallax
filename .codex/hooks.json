{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$p\" ] && [ -f \"$p/scripts/claude-hooks/main-tree-guard.py\" ] && exec python3 \"$p/scripts/claude-hooks/main-tree-guard.py\"; exit 0'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$p\" ] && [ -f \"$p/scripts/claude-hooks/session-start-pull.py\" ] && exec python3 \"$p/scripts/claude-hooks/session-start-pull.py\"; exit 0'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$p\" ] && [ -f \"$p/scripts/claude-hooks/session-end-cleanup.py\" ] && exec python3 \"$p/scripts/claude-hooks/session-end-cleanup.py\"; exit 0'"
          }
        ]
      }
    ]
  }
}
